{
  "annotations": {},
  "description": "k6 test_id correlation with server RPS, JVM/Hikari saturation and shared RDS. Default environment is dev; prod remains selectable with an explicit shared-RDS warning.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(k6_http_reqs_total{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{scenario}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "k6 request rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "100 * sum(rate(k6_http_req_failed{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval])) / sum(rate(k6_http_reqs_total{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "failed",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "k6 failed request rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_seconds_bucket{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "k6 latency p95 / p99",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max(k6_vus{test_id=~\"$test_id\",scenario=~\"$test_scenario\"})",
          "instant": false,
          "legendFormat": "VUs",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(k6_dropped_iterations_total{test_id=~\"$test_id\",scenario=~\"$test_scenario\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "dropped iterations",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "k6 VUs / dropped iterations",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Compare trend with k6 request rate; k6 and server RPS are separate signals.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{application}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Server-side RPS",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Blue/Green pools are evaluated independently; sum(active)/sum(max) is intentionally not used.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max by (application, instance, color, pool) (hikaricp_connections_active{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"} / hikaricp_connections_max{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
          "instant": false,
          "legendFormat": "{{application}} {{instance}} {{color}} {{pool}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Server Hikari utilization",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "100 * sum by (application, instance, color) (jvm_memory_used_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"}) / sum by (application, instance, color) (jvm_memory_max_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
          "instant": false,
          "legendFormat": "{{application}} {{instance}} {{color}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Server JVM heap",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "description": "SHARED RDS — dev load can affect prod. Stop the run if CPU is >=80% for 5m, freeable memory <=128MiB, or connections exceed 80% of max.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "expression": "SEARCH('{AWS/RDS,DBInstanceIdentifier} MetricName=\"CPUUtilization\" DBInstanceIdentifier=\"$rds_instance_identifier\"', 'Average', 300)",
          "id": "rds_cpuutilization",
          "namespace": "AWS/RDS",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "ap-northeast-2"
        }
      ],
      "title": "Shared RDS — CPU during test",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 9,
      "options": {
        "content": "\n- `test_id` is the only correlation selector; user ID and booking ID are never metric tags.\n- The run must be preflighted against the environment allowlist and workload budget before traffic starts.\n- Shared RDS is always in scope, including when the selected target environment is `dev`.\n- Keep the local JSON summary/artifact after the 14-day metrics window expires.\n",
        "mode": "markdown"
      },
      "repeatDirection": "h",
      "title": "Load-test safety contract",
      "transparent": false,
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "beat",
    "generated",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Prometheus / Mimir is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Prometheus / Mimir",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "query": "label_values(http_server_requests_seconds_count, env)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Application",
        "multi": false,
        "name": "application",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\"}, application)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Deployment color",
        "multi": false,
        "name": "color",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, color)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "CloudWatch is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "CloudWatch",
        "multi": false,
        "name": "DS_CLOUDWATCH",
        "query": "cloudwatch",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Required CloudWatch dimension filter. Enter the existing shared RDS DBInstanceIdentifier; panels never search all RDS instances.",
        "includeAll": false,
        "label": "Shared RDS instance",
        "multi": false,
        "name": "rds_instance_identifier",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Load test",
        "multi": false,
        "name": "test_id",
        "query": "label_values(k6_http_reqs_total, test_id)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Optional k6 scenario filter; leave empty to show every scenario.",
        "includeAll": false,
        "label": "Scenario (optional)",
        "multi": false,
        "name": "test_scenario",
        "query": ".*",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "90 Load Test",
  "uid": "beat-load-test",
  "version": 1
}
