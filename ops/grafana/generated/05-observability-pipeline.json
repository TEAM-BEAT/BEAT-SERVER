{
  "annotations": {},
  "description": "Alloy self-monitoring, scrape health, and remote-write pipeline pressure. Cloud usage is tracked against the Free plan outside the data plane.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Requires the Alloy self exporter/scrape component in the selected environment.",
