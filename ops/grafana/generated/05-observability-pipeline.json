  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "beat",
    "generated",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Prometheus / Mimir is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Prometheus / Mimir",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "query": "label_values(http_server_requests_seconds_count, env)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Application",
        "multi": false,
        "name": "application",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\"}, application)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Deployment color",
        "multi": false,
        "name": "color",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, color)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
