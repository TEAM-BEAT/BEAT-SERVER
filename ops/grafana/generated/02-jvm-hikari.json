          "exemplar": true,
          "expr": "100 * sum by (instance, color) (jvm_memory_used_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"}) / sum by (instance, color) (jvm_memory_max_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
