      },
      "description": "Do not aggregate blue and green pools. A max per instance/color exposes the active saturation point.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
