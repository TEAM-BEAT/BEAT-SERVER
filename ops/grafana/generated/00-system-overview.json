{
  "annotations": {},
  "description": "Production-first BEAT overview. The shared RDS warning applies to every database signal.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate (RPS)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Valid business-template HTTP requests only. 5xx and capacity/load-shedding 429 are bad events; normal 4xx and domain 404 remain good responses.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": []
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "100 * min(beat_application_success_ratio:14d{env=~\"$env\",application=~\"$application\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Application Success SLI",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Capacity/load-shedding 429 is tracked separately from other client errors.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\",status=~\"5..\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "5xx",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum(rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\",status=\"429\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "429",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "5xx and 429 rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Quantiles are derived from Prometheus histogram buckets; client-side percentiles are intentionally not used.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request latency p95 / p99",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Blue/Green is never summed. The maximum utilization for each instance and deployment color is the saturation signal.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max by (env, application, instance, color, pool) (hikaricp_connections_active{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"} / hikaricp_connections_max{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
          "instant": false,
          "legendFormat": "{{application}} {{instance}} {{color}} {{pool}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Hikari utilization (max per instance/color)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Any sustained pending value is actionable at instance/color level, even while another color is idle.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "max by (env, application, instance, color, pool) (hikaricp_connections_pending{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
          "instant": false,
          "legendFormat": "{{application}} {{instance}} {{color}} {{pool}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Hikari pending connections",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "100 * sum by (env, application, instance, color) (jvm_memory_used_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"}) / sum by (env, application, instance, color) (jvm_memory_max_bytes{area=\"heap\",env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"})",
          "instant": false,
          "legendFormat": "{{application}} {{instance}} {{color}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "JVM heap used",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "description": "SHARED RDS — dev load can affect prod. CloudWatch cannot separate beatDev and beatProd schemas.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "expression": "SEARCH('{AWS/RDS,DBInstanceIdentifier} MetricName=\"CPUUtilization\" DBInstanceIdentifier=\"$rds_instance_identifier\"', 'Average', 300)",
          "id": "rds_cpuutilization",
          "namespace": "AWS/RDS",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "ap-northeast-2"
        }
      ],
      "title": "Shared RDS — CPU",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Logs keep trace_id in the entry body; Loki labels remain bounded to env/cluster/host/module/level.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": false,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showLogContextToggle": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{env=~\"$env\",module=~\"$module\",level=\"ERROR\"}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "ERROR logs",
      "transparent": false,
      "type": "logs"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 10,
      "options": {
        "content": "\n**Scope:** `env=dev|prod` is the Prometheus/Loki operational label. OTel resources use `deployment.environment.name=development|production`.\n\n**SLO:** Application Success SLI is measured for known business routes. External DNS/TLS/Nginx failures require the Phase 2 synthetic checks.\n\n**Data safety:** user ID, booking ID, raw URL, SQL text and trace ID are never metric labels.\n",
        "mode": "markdown"
      },
      "repeatDirection": "h",
      "title": "Signal contract",
      "transparent": false,
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "beat",
    "generated",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Prometheus / Mimir is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Prometheus / Mimir",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "query": "label_values(http_server_requests_seconds_count, env)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Application",
        "multi": false,
        "name": "application",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\"}, application)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Deployment color",
        "multi": false,
        "name": "color",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, color)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Loki is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "DS_LOKI",
        "query": "loki",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "includeAll": true,
        "label": "Log module",
        "multi": false,
        "name": "module",
        "query": "label_values({env=~\"$env\"}, module)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "CloudWatch is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "CloudWatch",
        "multi": false,
        "name": "DS_CLOUDWATCH",
        "query": "cloudwatch",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Required CloudWatch dimension filter. Enter the existing shared RDS DBInstanceIdentifier; panels never search all RDS instances.",
        "includeAll": false,
        "label": "Shared RDS instance",
        "multi": false,
        "name": "rds_instance_identifier",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "00 System Overview",
  "uid": "beat-system-overview",
  "version": 1
}
