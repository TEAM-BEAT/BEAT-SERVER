{
  "annotations": {},
  "description": "Route-level RED, instance/color traffic, and trace search. Tempo environment values are mapped to OTel standard names.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RPS by route",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 latency by route",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP status rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum by (instance, color) (rate(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\",uri=~\"^/api(/.*)?$\",uri!~\"^/(actuator|health|metrics|v3/api-docs|swagger-ui)(/.*)?$|^(UNKNOWN|NOT_FOUND)$\",instance=~\"$instance\",color=~\"$color\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{instance}} {{color}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Traffic by instance and color",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": true,
          "expr": "sum by (instance, color) (rate(jvm_gc_pause_seconds_sum{env=~\"$env\",application=~\"$application\",instance=~\"$instance\",color=~\"$color\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{instance}} {{color}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "JVM GC pause rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Trace search is scoped by the OTel environment mapping; use trace-to-logs for the same trace ID.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 12,
        "y": 24
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "reducer": [],
          "show": false
        },
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "filters": [],
          "limit": 50,
          "refId": "A",
          "search": "{ resource.service.name =~ \"beat-.*\" && resource.deployment.environment.name = \"$tempo_environment\" && name =~ \"(?i).*http.*\" }"
        }
      ],
      "title": "Outbound HTTP spans",
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "DB span names only; SQL text is intentionally not used as a label or dashboard variable.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "reducer": [],
          "show": false
        },
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "filters": [],
          "limit": 50,
          "refId": "A",
          "search": "{ resource.service.name =~ \"beat-.*\" && resource.deployment.environment.name = \"$tempo_environment\" && (name =~ \"(?i).*mysql.*\" || name =~ \"(?i).*jdbc.*\") }"
        }
      ],
      "title": "Database spans",
      "transparent": false,
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Use the log entry trace_id to pivot to Tempo. The application filter is applied to the log body because logs use module labels.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": false,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showLogContextToggle": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{env=~\"$env\",module=~\"$module\",level=~\"ERROR|WARN\"} |~ `$application`",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Route errors with trace context",
      "transparent": false,
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "beat",
    "generated",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Prometheus / Mimir is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Prometheus / Mimir",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "query": "label_values(http_server_requests_seconds_count, env)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Application",
        "multi": false,
        "name": "application",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\"}, application)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, instance)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "includeAll": true,
        "label": "Deployment color",
        "multi": false,
        "name": "color",
        "query": "label_values(http_server_requests_seconds_count{env=~\"$env\",application=~\"$application\"}, color)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Loki is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "DS_LOKI",
        "query": "loki",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "allValue": ".*",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "includeAll": true,
        "label": "Log module",
        "multi": false,
        "name": "module",
        "query": "label_values({env=~\"$env\"}, module)",
        "refresh": 1,
        "skipUrlSync": false,
        "type": "query"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "description": "Tempo is selected at dashboard load; its UID is never committed.",
        "includeAll": false,
        "label": "Tempo",
        "multi": false,
        "name": "DS_TEMPO",
        "query": "tempo",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "text": "production",
          "value": "production"
        },
        "description": "Tempo uses the OTel standard deployment.environment.name values; dev maps to development and prod to production.",
        "includeAll": false,
        "label": "Tempo environment",
        "multi": false,
        "name": "tempo_environment",
        "query": "development,production",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "01 Service Deep Dive",
  "uid": "beat-service-deep-dive",
  "version": 1
}
