FROM eclipse-temurin:25.0.3_9-jre-alpine-3.23@sha256:28db6fdf60e38945e43d840c0333aeaec66c15943070104f7586fd3c9d1665b0

ARG MODULE

# Alpine repositories retain current patch revisions; Trivy is the vulnerability gate.
RUN apk add --no-cache --upgrade \
    libcrypto3 \
    libexpat \
    libssl3 \
    openssl \
    p11-kit \
    p11-kit-trust

RUN addgroup -g 10001 -S beat && adduser -S -u 10001 -G beat beat && mkdir -p /app && chown beat:beat /app

WORKDIR /app

LABEL beat.module="${MODULE}"

COPY --chown=beat:beat app.jar /app/app.jar

USER beat

ENTRYPOINT ["java", "-Duser.timezone=Asia/Seoul", "-jar", "/app/app.jar"]
